    Name: CamLidarCalibration
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Background Subtracted PC1/Topic1
        - /Full Cloud1
      Splitter Ratio: 0.5
    Tree Height: 369
Visualization Manager:
  Class: ""
  Displays:
